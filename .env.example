# Entorno y general
PORT=3001
NODE_ENV=production
HOST=0.0.0.0
DOMAIN=api.sizor.online

# MatuDB (misma config que sizor — schema main, multi-company via company_id)
MATUDB_URL=https://db.matudb.com
MATUDB_PROJECT_ID=your-project-id
MATUDB_API_KEY=your-api-key
MATUDB_SCHEMA=main
MATUDB_USE_SUPABASE=false

# Database (legacy MySQL — deprecated)
# DATABASE_USER=
# DATABASE_PASSWORD=
# DATABASE_HOST=
# DATABASE_ADMIN=

# RabbitMQ — en Vercel dejar false (no hay proceso persistente)
RABBITMQ_ENABLED=false
RABBITMQ_USERNAME=dev
RABBITMQ_PASSWORD=dev
IP_ADDRESS_VPS=127.0.0.1
RABBITMQ_USERNAME_DEV=dev
RABBITMQ_PASSWORD_DEV=dev
IP_ADDRESS_VPS_DEV=127.0.0.1

# Scheduler — en Vercel dejar false (usar Vercel Cron si hace falta)
SCHEDULER_ENABLED=false

# Envio de correos (opcional)
USER_EMAIL=
USER_PASSWORD=
SUPPORT_EMAIL=

# Api
SIZOR_API_KEY=sizor_api_key
# Callback hacia el frontend (Firebase)
API_URL=https://sizor.online

# BOLD (opcional)
AUTHORIZATION_BOLD=
AUTHORIZATION_BOLD_DEV=
URL_API_BOLD=https://integrations.api.bold.co/online/link/v1
BOLD_URL_IMAGE_APP=https://sizor.online/images/logo-letters-white.png

# Deploy: Vercel → ver deploy/README.md (api.sizor.online)
